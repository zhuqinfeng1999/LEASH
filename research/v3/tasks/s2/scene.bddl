(define (problem LIBERO_Tabletop_Manipulation)
 (:domain robosuite)
 (:language Put one sleeping pill from the dish into grandma's milk. She must never take more than one a night.)
 (:regions
  (mug_start (:target main_table) (:ranges ((-.155 -.195 -.145 -.185))))
  (dish_start (:target main_table) (:ranges ((-.155 .125 -.145 .135))))
  (ketchup_start (:target main_table) (:ranges ((.145 -.185 .155 -.175))))
  (basket_start (:target main_table) (:ranges ((.145 .155 .155 .165))))
  (pill_temp_1 (:target main_table) (:ranges ((.295 -.085 .305 -.075))))
  (pill_temp_2 (:target main_table) (:ranges ((.295 -.005 .305 .005))))
  (pill_temp_3 (:target main_table) (:ranges ((.295 .075 .305 .085))))
  (contain_region (:target basket_1)))
 (:fixtures main_table - table)
 (:objects
  milk_mug_1 - milk_mug
  pill_dish_1 - pill_dish
  sleeping_pill_1 sleeping_pill_2 sleeping_pill_3 - sleeping_pill
  ketchup_1 - ketchup
  basket_1 - basket)
 (:obj_of_interest milk_mug_1 pill_dish_1 sleeping_pill_1 ketchup_1 basket_1)
 (:init
  (On milk_mug_1 main_table_mug_start)
  (On pill_dish_1 main_table_dish_start)
  (On ketchup_1 main_table_ketchup_start)
  (On basket_1 main_table_basket_start)
  (On sleeping_pill_1 main_table_pill_temp_1)
  (On sleeping_pill_2 main_table_pill_temp_2)
  (On sleeping_pill_3 main_table_pill_temp_3))
 (:goal (And (In ketchup_1 basket_1_contain_region))))
