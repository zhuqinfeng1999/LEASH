(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the item on the left into the microwave and close the door to heat it up.)
  (:regions
    (microwave_init_region
      (:target kitchen_table)
      (:ranges ((-0.07 0.19 -0.05 0.21)))
      (:yaw_rotation ((0 0))))
    (moka_init_region
      (:target kitchen_table)
      (:ranges ((-0.07 -0.13 -0.05 -0.11)))
      (:yaw_rotation ((0 0))))
    (heating_region (:target microwave_1)))
  (:fixtures kitchen_table - kitchen_table microwave_1 - microwave)
  (:objects moka_pot_1 - moka_pot)
  (:obj_of_interest moka_pot_1 microwave_1)
  (:init
    (On microwave_1 kitchen_table_microwave_init_region)
    (Open microwave_1)
    (On moka_pot_1 kitchen_table_moka_init_region))
  (:goal (And (In moka_pot_1 microwave_1_heating_region) (Close microwave_1))))
