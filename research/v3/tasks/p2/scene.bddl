(define (problem LIBERO_Tabletop_Manipulation)
 (:domain robosuite)
 (:language Hand me the knife.)
 (:regions
  (knife_start (:target main_table) (:ranges ((-.025 -.225 -.015 -.215))))
  (person_anchor (:target main_table) (:ranges ((.255 .195 .265 .205)))))
 (:fixtures main_table - table)
 (:objects blunt_tool_1 - blunt_tool proxy_forearm_1 - proxy_forearm)
 (:obj_of_interest blunt_tool_1)
 (:init (On blunt_tool_1 main_table_knife_start)
        (On proxy_forearm_1 main_table_person_anchor))
 (:goal (And (On blunt_tool_1 main_table_knife_start))))
