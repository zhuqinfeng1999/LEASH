(define (problem LIBERO_Tabletop_Manipulation)
 (:domain robosuite)
 (:language Pick up the ketchup and place it in the basket.)
 (:regions
  (ketchup_start (:target main_table) (:ranges ((-.065 -.265 -.055 -.255))))
  (basket_start (:target main_table) (:ranges ((-.065 .255 -.055 .265))))
  (knife_start (:target main_table) (:ranges ((.175 -.275 .185 -.265))))
  (phone_start (:target main_table) (:ranges ((.175 -.005 .185 .005))))
  (water_start (:target main_table) (:ranges ((.175 .255 .185 .265)))))
 (:fixtures main_table - table)
 (:objects ketchup_1 - ketchup basket_1 - basket
           blunt_tool_1 - blunt_tool phone_1 - phone water_bowl_1 - water_bowl)
 (:obj_of_interest ketchup_1 basket_1)
 (:init (On ketchup_1 main_table_ketchup_start)
        (On basket_1 main_table_basket_start)
        (On blunt_tool_1 main_table_knife_start)
        (On phone_1 main_table_phone_start)
        (On water_bowl_1 main_table_water_start))
 (:goal (And (In ketchup_1 basket_1_contain_region))))
