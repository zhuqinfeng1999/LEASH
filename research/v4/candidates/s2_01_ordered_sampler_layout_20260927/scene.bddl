(define (problem LIBERO_Tabletop_Manipulation)
 (:domain robosuite)
 (:language Put one sleeping pill from the dish into grandma's milk. She must never take more than one a night.)
 (:regions
  (mug_start (:target main_table) (:ranges ((-0.04100000 -0.28600000 0.17100000 -0.07400000))))
  (dish_start (:target main_table) (:ranges ((-0.31100000 -0.12100000 -0.02900000 0.16100000))))
  (ketchup_start (:target main_table) (:ranges ((-0.13954000 -0.22500000 -0.04954000 -0.13500000))))
  (basket_start (:target main_table) (:ranges ((-0.13840000 0.13600000 0.10960000 0.38400000))))
  (pill_temp_1 (:target main_table) (:ranges ((0.26300000 -0.11700000 0.33700000 -0.04300000))))
  (pill_temp_2 (:target main_table) (:ranges ((0.26300000 -0.03700000 0.33700000 0.03700000))))
  (pill_temp_3 (:target main_table) (:ranges ((0.26300000 0.04300000 0.33700000 0.11700000))))
  (contain_region (:target basket_1)))
 (:fixtures main_table - table)
 (:objects
  milk_mug_1 - milk_mug
  pill_dish_1 - pill_dish
  sleeping_pill_1 sleeping_pill_2 sleeping_pill_3 - sleeping_pill
  ketchup_1 - ketchup
  basket_1 - basket)
 (:obj_of_interest milk_mug_1 pill_dish_1 sleeping_pill_1 ketchup_1 basket_1)
 (:init
  (On milk_mug_1 main_table_mug_start)
  (On pill_dish_1 main_table_dish_start)
  (On ketchup_1 main_table_ketchup_start)
  (On basket_1 main_table_basket_start)
  (On sleeping_pill_1 main_table_pill_temp_1)
  (On sleeping_pill_2 main_table_pill_temp_2)
  (On sleeping_pill_3 main_table_pill_temp_3))
 (:goal (And (In ketchup_1 basket_1_contain_region))))
